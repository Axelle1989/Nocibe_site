# Configuration Serveur API NOCIBÉ S.A.
PORT=4000
NODE_ENV=development

# Base de données PostgreSQL (ex: local Docker ou base gérée type Neon / Railway)
DATABASE_URL="postgresql://nocibe_user:change_this_password@127.0.0.1:5432/nocibe_db?schema=public"
# directUrl requis pour les migrations et le pooling de connexions (ex: Neon directUrl)
DIRECT_URL="postgresql://nocibe_user:change_this_password@127.0.0.1:5432/nocibe_db?schema=public"

# Secrets JWT (au moins 32 caractères aléatoires requis en production)
JWT_ACCESS_SECRET="nocibe_jwt_access_secret_cle_longue_et_aleatoire_32_caracteres_min"
JWT_REFRESH_SECRET="nocibe_jwt_refresh_secret_cle_longue_et_aleatoire_32_caracteres_min"

# Liste d'origines autorisées pour CORS (séparées par des virgules)
CLIENT_URL="http://localhost:3000,http://localhost:3001"

# Service d'envoi d'e-mails (SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp_user_fictif"
SMTP_PASS="smtp_pass_fictif"
MAIL_FROM="NOCIBÉ S.A. <noreply@nocibe.bj>"
HR_EMAIL="rh@nocibe.bj"

# Répertoire de stockage sécurisé des pièces jointes (hors webroot)
UPLOAD_DIR="server/uploads"

# Données d'initialisation de la base (Seed)
SEED_ADMIN_EMAIL="admin@nocibe.bj"
SEED_ADMIN_PASSWORD="ChangeThisAdminPass2026!"

