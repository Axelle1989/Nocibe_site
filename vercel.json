{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/mot-du-directeur", "destination": "/histoire#mot-du-directeur", "permanent": true },
    { "source": "/nos-valeurs", "destination": "/equipe-direction#valeurs", "permanent": true },
    { "source": "/caracteristiques-techniques", "destination": "/produits#specifications", "permanent": true },
    { "source": "/partenaires", "destination": "/realisations", "permanent": true },
    { "source": "/grands-chantiers", "destination": "/realisations", "permanent": true },
    { "source": "/developpement-durable", "destination": "/objectifs-2030#developpement-durable", "permanent": true },
    { "source": "/engagements-rse", "destination": "/objectifs-2030#developpement-durable", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.tile.openstreetmap.org; connect-src 'self' http://localhost:4000 http://127.0.0.1:4000 https://router.project-osrm.org https://*.tile.openstreetmap.org; frame-ancestors 'none';"
        }
      ]
    }
  ]
}
